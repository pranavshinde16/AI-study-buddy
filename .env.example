# Copy this file to `.env` (same folder) and fill in the blanks.
#   Windows (PowerShell):  Copy-Item .env.example .env
#   macOS / Linux:         cp .env.example .env
# `.env` is gitignored, so never commit real keys.

# --- App ---
APP_ENV=development                 # development | test | production
SECRET_KEY=change-me                # used to sign JWTs; set a long random string outside development
ACCESS_TOKEN_EXPIRE_MINUTES=1440    # JWT lifetime (24 h)
DATABASE_URL=postgresql+psycopg://studybuddy:studybuddy@localhost:5432/studybuddy  # matches docker-compose `db`
STORAGE_DIR=../storage              # uploads/audio, relative to backend/
MAX_UPLOAD_MB=500                   # max lecture file size
CORS_ORIGINS=http://localhost:5173  # comma-separated list of allowed frontend origins
LOG_LEVEL=INFO                      # DEBUG | INFO | WARNING | ERROR
LOG_JSON=true                       # true = JSON log lines (structlog); false = readable console output

# --- Postgres container (docker-compose `db` service) ---
POSTGRES_USER=studybuddy
POSTGRES_PASSWORD=studybuddy
POSTGRES_DB=studybuddy

# --- Speech recognition ---
ASR_PROVIDER=groq                   # groq (free tier, default) | local (faster-whisper, offline) | openai (paid, opt-in)
ASR_MODEL=whisper-large-v3-turbo
GROQ_API_KEY=                       # free key from https://console.groq.com/keys
GROQ_BASE_URL=https://api.groq.com/openai/v1  # Groq's OpenAI-compatible endpoint
OPENAI_API_KEY=                     # OPTIONAL, paid. Only used if a provider is explicitly set to openai; never a fallback
OPENAI_ASR_MODEL=whisper-1          # used only with ASR_PROVIDER=openai (whisper-1 returns segment timestamps)
ASR_LANGUAGE=                       # e.g. en; blank = Whisper detects the language
ASR_CHUNK_SEC=600                   # audio is cut into pieces of this many seconds before transcription
ASR_MAX_CHUNK_MB=24                 # pieces larger than this are cut again (Groq free tier limit is 25 MB)
LOCAL_ASR_MODEL=small               # faster-whisper model for ASR_PROVIDER=local (tiny|base|small|medium|large-v3)
LOCAL_ASR_DEVICE=cpu                # cpu | cuda
LOCAL_ASR_COMPUTE_TYPE=int8         # int8 is fastest on CPU; float16 on GPU
FFMPEG_BIN=ffmpeg                   # ffmpeg executable (name on PATH or full path)
FFPROBE_BIN=ffprobe                 # ffprobe executable
MEDIA_TIMEOUT_SEC=1800              # max seconds for one ffmpeg run

# --- LLM ---
LLM_PROVIDER=groq                   # groq (free tier, default) | openai (paid, opt-in)
LLM_MODEL=openai/gpt-oss-120b       # open-weight model hosted on Groq (free tier); not the paid OpenAI API
JUDGE_MODEL=openai/gpt-oss-120b     # LLM-as-judge model: grades short quiz answers (Phase 6) and evaluations
LLM_MAX_RETRIES=3                   # retries on 429/outage, SAME provider only (never a paid fallback)
LLM_BACKOFF_BASE_SEC=2.0            # backoff = base * 2^retry seconds, or the provider's Retry-After
LLM_BACKOFF_MAX_SEC=30.0            # cap for a single backoff wait
LLM_TIMEOUT_SEC=120                 # per-request timeout
LLM_MAX_OUTPUT_TOKENS=4096          # default output cap (a prompt YAML can override it)
LLM_REASONING_EFFORT=low            # low | medium | high | blank = provider default. gpt-oss "thinks" before answering;
                                    # low keeps those hidden tokens (which count towards Groq's limits) small. groq/openai only
GROQ_TOKENS_PER_MINUTE=8000         # the app paces its own Groq requests to stay under the free-tier TPM limit; 0 = off

# --- Summary & notes ---
SUMMARY_AUTO=true                   # generate summary + topic notes automatically after transcription
SUMMARY_SINGLE_PASS_MAX_TOKENS=3500 # transcripts longer than this (~17 min of speech) use map-reduce over windows
SUMMARY_WINDOW_SEC=600              # map-reduce window length (~10 min)
SUMMARY_WINDOW_MAX_TOKENS=2500      # hard cap per window so a single request fits the 8K tokens/minute free tier

# --- Quiz, grading & flashcards ---
QUIZ_MAX_QUESTIONS=20               # upper limit for num_questions in one quiz
QUIZ_CONTEXT_MAX_TOKENS=2500        # transcript tokens per quiz/flashcard request (fits the free-tier TPM)
QUIZ_MAX_REGEN_ROUNDS=2             # extra requests to replace questions that fail validation
SHORT_ANSWER_SIM_THRESHOLD=0.85     # embedding fallback: similarity >= this counts as correct. bge-small rates even
                                    # unrelated sentences ~0.75, so keep it high; check with `python -m scripts.embedding_smoke`
MASTERY_EMA_ALPHA=0.3               # weight of the newest quiz result in a topic's mastery score
MASTERY_WEAK_THRESHOLD=0.6          # topics with mastery below this are reported as weak
FLASHCARDS_MAX_CARDS=30             # cards per generated deck (definitions + concepts)

# --- Embeddings & retrieval (RAG) ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5  # local sentence-transformers model, free; downloads (~130 MB) on first use
EMBEDDING_DEVICE=cpu                # cpu | cuda
CHROMA_DIR=../storage/chroma        # persistent vector store folder
RAG_TOP_K=5                         # chunks retrieved per question
RAG_MIN_SCORE=0.35                  # below this similarity the app answers "not covered in the lecture"

# --- Fine-tuned / base SLM served by Ollama ---
FINETUNED_BASE_URL=http://localhost:11434/v1
FINETUNED_MODEL_TAG=study-buddy-qwen
BASE_SLM_MODEL_TAG=qwen3:1.7b
