# Frontend settings for Vite. Copy to frontend/.env (gitignored) and change what you need.
# Only VITE_* variables are sent to the browser; never put secrets in this file.

# Backend the dev server's /api proxy forwards to (not exposed to the browser).
# Default http://localhost:8000. Example for a second backend on another port: http://localhost:8001
API_PROXY_TARGET=http://localhost:8000

# Upload size limit shown and checked in the browser, in MB. Keep it equal to the backend's
# MAX_UPLOAD_MB (root .env); the backend's 413 FILE_TOO_LARGE is the real limit.
VITE_MAX_UPLOAD_MB=500
